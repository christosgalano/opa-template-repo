{
  "name": "OPA Policy Development",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "open-policy-agent.opa",
        "StyraInc.regal"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [
          120
        ]
      }
    }
  }
}
